<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A vault is a Syncthing folder anywhere on shared storage, holding tens of thousands of
      files. The Storage Access Framework cannot see one that already exists and is 25-50x
      slower when it can (MOBILE_DESIGN.md, Architecture), so this is the permission the app
      asks for — the same one Markor ships with.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- A walk holds a foreground service, so that leaving the app does not freeze it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The stylus is what draws; a device without one still reads and edits. -->
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:name=".AccentApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Accent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The other half of the app: a PDF viewer with a pen, with no vault in sight. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <service
            android:name=".IndexingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

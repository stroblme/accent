bench editor prefs nano=1 chosen=nano
bench editor open title=note.md icon=filetype-markdown-symbolic subtitle=note.md row=Some("note.md") args=Some("fake-editor <vault>/note.md")
bench editor open again terminals=1 kinds=["editor", "diagram", "notebook", "image"]
bench editor exit0 closed=true edited=true
bench editor exit1 kept=true said=true line=Some("[Exited with code 1]")
bench editor missing kind=text toasted=1
bench editor preview first=none second=editor
bench editor keys at=Editor bytes=17 05 0a
bench editor keys ctrl+Page_Up=other.md ctrl+Tab=other.md palette=true kept=true
bench editor accent preview_asks=false kept_asks=true kind=text editors=0
bench editor line hit=Some("fake-editor +3 <vault>/deep.md") symbol=Some("fake-editor +2 <vault>/code.rs") again_front=Some("deep.md") again_starts=0
bench editor custom args=Some("fake-editor --at 2 <vault>/custom.md")
bench editor hold started=true starts=1
bench editor back title=Some("held.md") starts=1
bench editor back title=Some("held.md") starts=2

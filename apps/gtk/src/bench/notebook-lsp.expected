bench notebook_lsp open key=lsp.ipynb.py
bench notebook_lsp diagnostics cells=0,1,0 underlined=-,[1],- unused=0 counts=Some("2 errors")
bench notebook_lsp lazy built=0 waiting=1 painted_on_build=1
bench notebook_lsp press pressable=true tooltip=Some("Hide these in the text; the pointer still shows them") hidden_underlined=0 back=2
bench notebook_lsp hover "x at 3:4"
bench notebook_lsp definition cell=1 at=1:0
bench notebook_lsp complete rows=alpha,beta,gamma text="y = x + oops.alpha(x)" import_written=0
bench notebook_lsp signature "<tt>f(<b>a</b>, b)</tt>"
bench notebook_lsp moved hover "x at 4:4"
bench notebook_lsp marimo key=lsp_marimo.py definition cell=0 at=0:0

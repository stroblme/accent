bench graph open front=a.md nodes=["a.md", "b.md", "c.md", "e.md", "gone.md?"] links=5
bench graph split b.md front=b.md shown=true panes=2
bench graph narrowed lit_before=b.md lit=none
bench graph ease easing=true ended=true kept=true
bench graph click c.md opened=c.md pane=2 preview=true keyboard=graph tabs=1
bench graph grow c.md roots=["a.md", "b.md", "c.md"] nodes=["a.md", "b.md", "c.md", "e.md", "f.md", "gone.md?"] front=c.md
bench graph click b.md opened=b.md pane=2 preview=true keyboard=graph tabs=1
bench graph grow b.md roots=["a.md", "b.md", "c.md"] nodes=["a.md", "b.md", "c.md", "e.md", "f.md", "gone.md?"] front=b.md
bench graph update c.md nodes+=["d.md"] kept=true
bench graph rename b.md bee.md index_kept=true roots=["a.md", "bee.md", "c.md"] nodes+=["b.md?", "bee.md"]
bench graph tags nodes+=["#topic"]
bench graph images nodes+=["pic.png"]
bench graph toggles queries=2 same=true
bench graph ghost gone.md dialog=Some("gone.md")
bench graph all orphans=false nodes=["#topic", "a.md", "b.md?", "bee.md", "c.md", "d.md", "e.md", "f.md", "gone.md?", "main.py", "pic.png", "util.py"]
bench graph orphans nodes+=["lone.md"]
bench graph reset all=false roots=["bee.md"] nodes=["bee.md", "c.md"]
bench graph hidden queries=0 shown_again=1 nodes+=["e.md"]
bench graph find typed="bee" shown=["bee.md", "e.md"] readout="2 matches" kept=true zoom=Fit
bench graph find step current=bee.md readout="1 of 2" keyboard=bar zoom=100 %
bench graph find opens current=e.md readout="2 of 2" opened=e.md keyboard=bar
bench graph find closed keyboard=graph current=e.md shown=["bee.md", "c.md", "e.md"] zoom=Fit
bench graph find enter typed="c" current=c.md
bench graph find reset roots=["e.md"] shown=["a.md", "bee.md"] readout="2 matches"
bench graph find none shown=[] invalid=("Invalid query", true) kept=true
bench graph arrows moved=true
bench graph enter a.md moved=true alone=true
bench graph session restored=true front=a.md
bench graph saved all=false unresolved=true tags=true images=true orphans=true
bench graph still roots=["lone.md"] nodes=["lone.md"] settled_at_once=true
bench graph closed worker_ended=true

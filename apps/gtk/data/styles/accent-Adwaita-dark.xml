<?xml version="1.0" encoding="UTF-8"?>
<!-- Adwaita-dark with no draw-spaces colour, so an annotation without a severity takes the view's
     foreground at half alpha (theme::scheme_id). -->
<style-scheme id="accent-Adwaita-dark" name="Adwaita-dark (accent)" version="1.0" parent-scheme="Adwaita-dark">
  <style name="draw-spaces"/>
</style-scheme>

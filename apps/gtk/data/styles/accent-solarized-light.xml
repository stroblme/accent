<?xml version="1.0" encoding="UTF-8"?>
<!-- solarized-light with no draw-spaces colour, so an annotation without a severity takes the view's
     foreground at half alpha (theme::scheme_id). -->
<style-scheme id="accent-solarized-light" name="solarized-light (accent)" version="1.0" parent-scheme="solarized-light">
  <style name="draw-spaces"/>
</style-scheme>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  The icons Adwaita has no glyph for: the completion kinds, the drawing tools, the file types
  every file list leads its rows with, and a server rack for a remote vault (the theme's
  `network-server` is a box on a cable, or a tower). They are shipped with the binary rather than
  looked up in the theme; the prefix is what `IconTheme::add_resource_path` is pointed at, so GTK
  finds them by name like any other icon. `filetype-*` rather than `file-*`, which themes already
  use.
-->
<gresources>
  <gresource prefix="/io/github/stroblme/Accent">
    <file preprocess="xml-stripblanks">icons/scalable/actions/lsp-class-symbolic.svg</file>
    <file preprocess="xml-stripblanks">icons/scalable/actions/lsp-constant-symbolic.svg</file>

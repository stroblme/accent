[Desktop Entry]
Type=Application
Name=Accent
Comment=Markdown and PDF knowledge editor
Exec=env GSK_RENDERER=cairo accent %F
Icon=io.github.stroblme.Accent
Terminal=false
Categories=Office;Utility;TextEditor;GTK;GNOME;
Keywords=markdown;notes;vault;wiki;pdf;
MimeType=text/markdown;inode/directory;application/pdf;text/plain;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=env GSK_RENDERER=cairo accent --new-window

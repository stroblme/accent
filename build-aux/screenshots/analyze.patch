+def drop_outliers(values, spread=3.0):
+    """`values` without the runs further than `spread` deviations from their median."""
+    if len(values) < 3:
+        return values
+    centre, scale = statistics.median(values), statistics.stdev(values)
+    return [v for v in values if abs(v - centre) <= spread * scale]
